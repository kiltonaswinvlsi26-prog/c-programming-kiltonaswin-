#include &lt;stdio.h&gt;
#include &lt;string.h&gt;
int main()
{
char str1[50], str2[50], str3[100];
int res;
printf(&quot;Enter the first string: &quot;);
scanf(&quot;%s&quot;, str1);
printf(&quot;Enter the second string: &quot;);
scanf(&quot;%s&quot;, str2);
